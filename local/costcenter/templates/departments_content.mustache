                {{/ hide_feedbacks}} -->
                {{^ hide_classroom}}
                <div class="w-full pull-left mt-3 dept_details dept_classrooms">
                    <div class="pull-left col-lg-5 col-md-12 col-sm-12 col-12 px-2 deptdetails_left">
                        <span class="pull-left pr-2 classroomscolor"><i class="fa fa-desktop" aria-hidden="true"></i></span>
                        <span class="details_string pull-left">{{# str}} classrooms, local_costcenter {{/str}}</span>
                        <span class="pull-right details_count classroomscolor">{{ allclassroomcount }}</span>
                    </div>
                    <div class="pull-left col-lg-7 col-md-12 col-sm-12 col-12 px-2 deptdetails_right">
                        <span class="w-half pull-left inforight"><i class="fa fa-list-ul pr-1 pull-left newicon" aria-hidden="true"></i>
                            <span class="lable_name pull-left">{{# str}} new, local_costcenter {{/str}}<span class="label_colon pull-right mr-1">:</span></span><span class="classroomscolor">{{ newclassroomcount }}</span>
                        </span>

                         <span class="w-half pull-left"><i class="fa fa-lock pr-1 pull-left inactiveicon" aria-hidden="true"></i><span class="lable_name pull-left">{{# str}} inactive {{/str}}<span class="label_colon pull-right mr-1">:</span></span><span class="classroomscolor">{{ cancelledclassroomcount }}</span></span>

                         <span class="w-half pull-left inforight"><i class="fa fa-bullhorn pr-1 pull-left activeicon" aria-hidden="true"></i><span class="lable_name pull-left">{{# str}} active {{/str}}<span class="label_colon pull-right mr-1">:</span></span><span class="classroomscolor">{{ activeclassroomcount }}</span></span>

                         <span class="w-half pull-left"><i class="fa fa-flag-o pr-1 pull-left completeicon" aria-hidden="true"></i><span class="lable_name pull-left">{{# str}} completed, local_costcenter {{/str}}<span class="label_colon pull-right mr-1">:</span></span><span class="classroomscolor">{{ completedclassroomcount }}</span></span>
                    </div>
                </div>
                {{/ hide_classroom}}
                {{^ hide_program}}
                <div class="w-full pull-left mt-3 dept_details dept_programs">
