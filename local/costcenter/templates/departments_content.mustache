                        </span>

                         <span class="w-half pull-left"><i class="fa fa-user-times pr-1 pull-left inactiveicon" aria-hidden="true"></i><span class="lable_name pull-left">{{# str}} inactive {{/str}}<span class="label_colon pull-right mr-1">:</span></span><span class="feedbackscolor"><a href="{{count_feedbackinactivelink_url}}" class='viewlink' title= "{{#str}} inactivefeedback, local_costcenter {{/str}}">{{ dept_feedbackinactivecount }}</a></span></span>
